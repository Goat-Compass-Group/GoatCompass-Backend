<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1795768000000-1" author="minhdat">
        <dropUniqueConstraint tableName="external_ref" constraintName="uk_external_ref_entity_scheme_code"/>
        <addUniqueConstraint tableName="external_ref" constraintName="uk_external_ref_entity_scheme_code"
                             columnNames="entity_type, entity_id, scheme, external_code"/>
    </changeSet>

    <changeSet id="1795768000000-2" author="minhdat">
        <addPrimaryKey tableName="skill_alias" constraintName="pk_skill_alias" columnNames="skill_id, normalized"/>
        <addPrimaryKey tableName="occupation_alias" constraintName="pk_occupation_alias"
                       columnNames="occupation_id, normalized"/>
        <addPrimaryKey tableName="credential_skill" constraintName="pk_credential_skill"
                       columnNames="credential_id, skill_id"/>
    </changeSet>

    <changeSet id="1795768000000-3" author="minhdat">
        <addForeignKeyConstraint baseTableName="credential_skill" baseColumnNames="skill_id"
                                 referencedTableName="skill" referencedColumnNames="id"
                                 constraintName="fk_credential_skill_skill"/>
    </changeSet>

    <changeSet id="1795768000000-4" author="minhdat">
        <sql>CREATE UNIQUE INDEX idx_occupation_job_family_one_primary ON occupation_job_family (occupation_id) WHERE is_primary;</sql>
        <sql>CREATE INDEX idx_skill_embedding_hnsw ON skill_embedding USING hnsw (embedding vector_cosine_ops);</sql>
        <rollback>
            <sql>DROP INDEX idx_skill_embedding_hnsw;</sql>
            <sql>DROP INDEX idx_occupation_job_family_one_primary;</sql>
        </rollback>
    </changeSet>

    <changeSet id="1795768000000-5" author="minhdat">
        <dropIndex tableName="occupation_credential" indexName="ix_pk_occupation_credential"/>
        <dropIndex tableName="occupation_job_family" indexName="ix_pk_occupation_job_family"/>
        <dropIndex tableName="skill_embedding" indexName="ix_pk_skill_embedding"/>
        <dropIndex tableName="skill_relation" indexName="ix_pk_skill_relation"/>
    </changeSet>

    <changeSet id="1795768000000-6" author="minhdat">
        <dropForeignKeyConstraint baseTableName="revchanges"
                                  constraintName="fk_revchanges_on_default_tracking_modified_entities_changelog"/>
        <dropTable tableName="revchanges"/>
        <dropTable tableName="revinfo"/>
        <dropSequence sequenceName="revinfo_seq"/>
    </changeSet>
</databaseChangeLog>
